# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: omit for SQLite (default). Set for production Postgres.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aadme_lms

# CORS and invite links (match your Vite dev server or deployed SPA URL)
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (console backend is fine locally)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=lms@aadme.local

# Storage: 1 = local files under backend/media (default for dev/tests)
LMS_USE_LOCAL_STORAGE=1

# Supabase Storage (S3-compatible) — used when LMS_USE_LOCAL_STORAGE=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=aadme-lms
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-south-1